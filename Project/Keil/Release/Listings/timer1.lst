  71          
  72          // 定时器TMR1中断服务函数
  73          void TIMR1_IRQHandler(void) interrupt TMR1_IRQn
  74          {
  75   1          // 进入中断设置IP，不可删除
  76   1          __IRQnIPnPush(TMR1_IRQn);
  77   1      
  78   1          // ---------------- 用户函数处理 -------------------
  79   1      
  80   1          // 周期中断
  81   1          if (TMR1_CONH & TMR_PRD_PND(0x1))
  82   1          {
  83   2              TMR1_CONH |= TMR_PRD_PND(0x1); // 清除pending
  84   2      
  85   2              tmr1_cnt++;
  86   2          }
  87   1      
  88   1          // 退出中断设置IP，不可删除
  89   1          __IRQnIPnPop(TMR1_IRQn);
  90   1      }


