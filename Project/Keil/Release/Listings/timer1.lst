   1          #include "timer1.h"
   2          
   3          // tmr1，过热x min后继续降低占空比
   4          
   5          #define TMR1_CNT_TIME 15200 // 计数周期，15200 * 0.65625us 约等于10000us--10ms
   6          
   7          volatile u32 tmr1_cnt = 0; // 定时器TMR0的计数值（每次在中断服务函数中会加一）
   8          
   9          /**
  10           * @brief 配置定时器TMR0，定时器默认关闭
  11           */
  12          void tmr1_config(void)
  13          {
  14   1          __SetIRQnIP(TMR1_IRQn, TMR1_IQn_CFG); // 设置中断优先级（TMR1）
  15   1      
  16   1          TMR1_CONL &= ~(TMR_PRESCALE_SEL(0x07)); // 清除TMR1的预分频配置寄存器
  17   1          // 配置TMR1的预分频，为32分频，即21MHz / 32 = 0.65625MHz，约0.67us计数一次
  18   1          // （实际测试和计算得出这个系统时钟是21MHz的，但是还是有些误差，不是准确的21MHz）
  19   1          TMR1_CONL |= TMR_PRESCALE_SEL(0x05);
  20   1          TMR1_CONL &= ~(TMR_MODE_SEL(0x03)); // 清除TMR1的模式配置寄存器
  21   1          TMR1_CONL |= TMR_MODE_SEL(0x01);    // 配置TMR1的模式为计数器模式，最后对系统时钟的脉冲进行计数
  22   1      
  23   1          TMR1_CONH |= TMR_PRD_PND(0x01); // 清除TMR1的计数标志位，表示未完成计数
  24   1          TMR1_CONH |= TMR_PRD_IRQ_EN(1); // 使能TMR1的计数中断
  25   1      
  26   1          // 配置TMR1的计数周期
  27   1          TMR1_PRH = TMR_PERIOD_VAL_H((TMR1_CNT_TIME >> 8) & 0xFF);
  28   1          TMR1_PRL = TMR_PERIOD_VAL_L((TMR1_CNT_TIME >> 0) & 0xFF);
  29   1      
  30   1          // 清除TMR1的计数值
  31   1          TMR1_CNTL = 0;
  32   1          TMR1_CNTH = 0;
  33   1      
  34   1          TMR1_CONL &= ~(TMR_SOURCE_SEL(0x07)); // 清除TMR1的时钟源配置寄存器
  35   1          // TMR1_CONL |= TMR_SOURCE_SEL(0x07); // 配置TMR1的时钟源，使用系统时钟
  36   1          TMR1_CONL |= TMR_SOURCE_SEL(0x05); // 配置TMR1的时钟源，不用任何时钟
  37   1      
  38   1          // __EnableIRQ(TMR1_IRQn);                     // 使能中断
  39   1          __DisableIRQ(TMR1_IRQn); // 禁用中断
  40   1          IE_EA = 1;               // 打开总中断
  41   1      }
  42          
  43          /**
  44           * @brief 开启定时器TMR1，开始计时
  45           */
  46          void tmr1_enable(void)
  47          {
  48   1          // 重新给TMR1配置时钟
  49   1          TMR1_CONL &= ~(TMR_SOURCE_SEL(0x07)); // 清除定时器的时钟源配置寄存器
  50   1          TMR1_CONL |= TMR_SOURCE_SEL(0x06);    // 配置定时器的时钟源，使用系统时钟（约21MHz）
  51   1      
  52   1          __EnableIRQ(TMR1_IRQn); // 使能中断
  53   1          IE_EA = 1;              // 打开总中断
