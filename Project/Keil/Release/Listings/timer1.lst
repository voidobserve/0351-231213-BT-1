  56          /**
  57           * @brief 关闭定时器1，清空计数值
  58           */
  59          void tmr1_disable(void)
  60          {
  61   1          // 不给定时器提供时钟，让它停止计数
  62   1          TMR1_CONL &= ~(TMR_SOURCE_SEL(0x07)); // 清除定时器的时钟源配置寄存器
  63   1          TMR1_CONL |= TMR_SOURCE_SEL(0x05);    // 配置定时器的时钟源，不用任何时钟
